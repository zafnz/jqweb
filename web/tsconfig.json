{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "erasableSyntaxOnly": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2015",
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": true
  },
  "include": [
    "build.mjs",
    "*.ts",
    "src/**/*.ts"
  ]
}
